{{#> layout title=subject preheader=preheader footerNote="This email was sent from the Pentique website. Reply to it to write to the customer."}}
  <p style="margin: 0 0 4px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #b83280;">New order</p>
  <h1 style="margin: 0 0 6px 0; font-size: 26px; line-height: 1.25; color: #1f2937;">{{name}} placed an order</h1>
  <p style="margin: 0 0 24px 0; font-size: 14px; color: #6b7280;">Reference <strong style="color: #1f2937;">{{ref}}</strong> &middot; {{placedAt}}</p>

  {{#if hasStockWarnings}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0;">
    <tr>
      <td style="padding: 12px 16px; background-color: #fff7e0; border: 1px solid #fde4a0; border-radius: 8px; font-size: 14px; color: #92400e;">
        <strong>&#9888; Check the stock:</strong> some of the products ordered are marked below as more than is in stock.
      </td>
    </tr>
  </table>
  {{/if}}

  <!-- customer -->
  <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;">Customer</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0; background-color: #eaf1f8; border-radius: 10px;">
    <tr>
      <td style="padding: 14px 18px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size: 15px; line-height: 1.5;">
          <tr>
            <td class="stack label-cell" width="90" valign="top" style="padding: 4px 0; color: #6b7280;">Name</td>
            <td class="stack" valign="top" style="padding: 4px 0; color: #1f2937;">{{name}}</td>
          </tr>
          <tr>
            <td class="stack label-cell" valign="top" style="padding: 4px 0; color: #6b7280;">Email</td>
            <td class="stack" valign="top" style="padding: 4px 0;"><a href="mailto:{{email}}" style="color: #3e6a93;">{{email}}</a></td>
          </tr>
          <tr>
            <td class="stack label-cell" valign="top" style="padding: 4px 0; color: #6b7280;">Phone</td>
            <td class="stack" valign="top" style="padding: 4px 0;"><a href="tel:{{tel}}" style="color: #3e6a93;">{{tel}}</a></td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- delivery -->
  <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;">Delivery</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0; background-color: #eaf1f8; border-radius: 10px;">
    <tr>
      <td style="padding: 14px 18px; font-size: 15px; line-height: 1.6; color: #1f2937;">
        <strong>{{delivery.title}}</strong>
        {{#each delivery.details}}<br>{{this}}{{/each}}
        {{#if delivery.note}}<br><span style="color: #6b7280; font-size: 14px;">{{delivery.note}}</span>{{/if}}
      </td>
    </tr>
  </table>

  {{#if note}}
  <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;">Note from the customer</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0;">
    <tr>
      <td style="padding: 14px 18px; background-color: #fff7e0; border-radius: 10px; font-size: 15px; line-height: 1.6; color: #1f2937;">{{multiline note}}</td>
    </tr>
  </table>
  {{/if}}

  <!-- products -->
  <p style="margin: 0 0 8px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;">Products</p>
  {{> items}}
{{/layout}}
