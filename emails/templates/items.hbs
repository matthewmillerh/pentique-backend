<!-- The ordered products with the total, shared by the emails to the shop and to the customer -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top: 1px solid #e5e7eb;">
  {{#each items}}
  <tr>
    <td class="thumb" width="72" valign="top" style="padding: 14px 14px 14px 0; border-bottom: 1px solid #e5e7eb;">
      {{#if thumbUrl}}
      <img src="{{thumbUrl}}" alt="" width="58" height="58" style="display: block; width: 58px; height: 58px; object-fit: contain; border-radius: 8px; background-color: #f6f2f7;">
      {{else}}
      <div style="width: 58px; height: 58px; border-radius: 8px; background-color: #f6f2f7;">&nbsp;</div>
      {{/if}}
    </td>
    <td valign="top" style="padding: 14px 0; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #1f2937;">
      <strong>{{name}}</strong>
      {{#if code}}<span style="color: #9ca3af; font-size: 13px;">&nbsp;&middot;&nbsp;{{code}}</span>{{/if}}<br>
      <span style="color: #6b7280; font-size: 14px;">{{qty}} &times; {{priceFormatted}}{{#if onSpecial}} <span style="color: #b83280;">(on special, was {{wasFormatted}})</span>{{/if}}</span>
      {{#if stockWarning}}<br><span style="color: #b45309; font-size: 13px;">&#9888; {{stockWarning}}</span>{{/if}}
    </td>
    <td valign="top" align="right" style="padding: 14px 0 14px 12px; border-bottom: 1px solid #e5e7eb; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 600; color: #1f2937; white-space: nowrap;">
      {{lineTotalFormatted}}
    </td>
  </tr>
  {{/each}}
  <tr>
    <td colspan="2" align="right" style="padding: 16px 0 0 0; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 15px; color: #6b7280;">
      Total for {{itemCount}} {{#if singleItem}}item{{else}}items{{/if}}
    </td>
    <td align="right" style="padding: 14px 0 0 12px; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 700; color: #1f2937; white-space: nowrap;">
      {{totalFormatted}}
    </td>
  </tr>
  {{#if shippingNote}}
  <tr>
    <td colspan="3" align="right" style="padding: 4px 0 0 0; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 13px; color: #6b7280;">
      {{shippingNote}}
    </td>
  </tr>
  {{/if}}
</table>
